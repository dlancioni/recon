{
    "Id": 1,
    "Name": "Saldo x Extrato",
    "Description": "1:M reconciliation",
    "Datasources":
    [
        {
            "Side": 1,
            "Name": "Saldo",
            "File": "etc:saldo.txt",
            "Separator": ";",
            "Fields":
            [
                {"Id":1, "Name":"Data", "Type":"Datetime", "Value":"", "Mask":""},
                {"Id":2, "Name":"Agencia", "Type":"Integer", "Value":"", "Mask":""},
                {"Id":3, "Name":"Conta", "Type":"Text", "Value":"", "Mask":""},
                {"Id":4, "Name":"Saldo", "Type":"Decimal", "Value":"", "Mask":""}
            ]
        }
        ,
        {
            "Side": 2,
            "Name": "Extrato",
            "File": "etc:extrato.txt",
            "Separator": ";",
            "Fields": 
            [
                {"Id":1, "Name":"Data", "Type":"Datetime", "Value":"", "Mask":""},
                {"Id":2, "Name":"Agencia", "Type":"Integer", "Value":"", "Mask":""},
                {"Id":3, "Name":"Conta", "Type":"Text", "Value":"", "Mask":""},
                {"Id":4, "Name":"Saldo", "Type":"Decimal", "Value":"", "Mask":""}
            ]
        }
    ],
    "Recons":
    [
        {
            "Rule": "Agencia/Conta",
            "Fields":
            [
                {"Type":"Key", "Name":"Agencia"},
                {"Type":"Key", "Name":"Conta"},
                {"Type":"Compare", "Name":"Saldo", "Function":"Sum"},
                {"Type":"Compare", "Name":"Data"}
            ]
        }
    ]
}